{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DubVibe Studio",
  "version": "0.1.0",
  "identifier": "com.dubvibe.studio",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "DubVibe Studio",
        "width": 1600,
        "height": 980,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/dubvibe-backend-complete"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
